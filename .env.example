# ==============================================================================
# Campfire OS - Environment Variables
# ==============================================================================

# 1. DATABASE (PostgreSQL / Supabase / Neon)
# If empty, runs in high-performance localStorage client demo mode.
DATABASE_URL="postgresql://postgres:[PASSWORD]@db.[REF].supabase.co:5432/postgres?sslmode=require"

# 2. TOSS PAYMENTS / KAKAO PAY (Recurring Subscriptions)
TOSS_PAYMENTS_SECRET_KEY="test_sk_..."
TOSS_PAYMENTS_CLIENT_KEY="test_ck_..."

# 3. KAKAO ALIMTALK (Solapi / Aligo / Kakao Business)
KAKAO_ALIMTALK_API_KEY=""
KAKAO_SENDER_KEY=""

# 4. APP METADATA
NEXT_PUBLIC_APP_NAME="Campfire OS"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
